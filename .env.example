# ======================================================
# IDENTITAS & PORT PROYEK
# ======================================================
# Prefix nama container & volume (ubah untuk tiap proyek agar tidak bentrok)
COMPOSE_PROJECT_NAME=wp-site

# Port akses di browser
HTTP_PORT=8080
PMA_PORT=8081

# ======================================================
# INFORMASI SITUS WORDPRESS
# ======================================================
WP_TITLE="My WordPress Site"
WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=adminpassword123!
WP_ADMIN_EMAIL=admin@example.com

# ======================================================
# KREDENSIAL DATABASE
# ======================================================
DB_NAME=wordpress_db
DB_USER=wp_user
DB_PASSWORD=wp_secure_pass123!
DB_ROOT_PASSWORD=root_secure_pass123!

